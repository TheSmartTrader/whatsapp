rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check: true agar current user ki UID 'admins' collection mein document ID ke tor par maujood hai.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Any signed-in user can see the users directory (needed to start chats,
    // show DP/online status), but can only create/edit their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      // User apna profile khud edit kar sakta hai, ya admin kisi ka bhi (suspend ke liye).
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // User apna hi profile document delete kar sakta hai (account delete feature),
      // ya admin kisi bhi user ko delete kar sakta hai (admin panel feature).
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Admins collection: sirf Firebase Console se manage hoti hai, koi bhi client
    // ise seedha padh/likh nahi sakta. (isAdmin() function ka exists() check
    // rules-evaluation ke andar hi chalta hai, is 'deny' se affect nahi hota.)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Jab koi user account delete karta hai, uski wajah (reason) yahan save hoti hai.
    // Sirf apne liye entry bana sakta hai; kisi ko bhi ye padhne/badalne ki ijazat nahi
    // (sirf Firebase Console / admin backend se dekha ja sakta hai).
    match /account_deletions/{entryId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if false;
    }

    // A chat can only be read/written by its members.
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == request.auth.uid;

        // Sirf "status" field update karne ki ijazat hai (double-tick / seen ke liye),
        // taake message ka text/sender koi badal na sake.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }
    }

    // Calls: only the caller or callee can read/write, and only for
    // themselves (basic signaling protection).
    match /calls/{callId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if false;

      match /{sub}/{candidateId} {
        allow read, create: if request.auth != null;
      }
    }
  }
}
